# secrets
.env

# saved Zoom login (bot/zoom_login.py) — a live session, never commit
secrets/*
!secrets/.gitkeep

# CLIProxyAPI OAuth refresh tokens and local runtime configuration
cli-proxy/auths/*
!cli-proxy/auths/.gitkeep
cli-proxy/config.yaml

# recordings output — keep the placeholder
recordings/*
!recordings/.gitkeep

# logs written by the bot
recordings/logs/

# filebrowser runtime DB
filebrowser/filebrowser.db

# python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# claude code local settings
.claude/
